generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum SubscriptionPlan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
  TRIALING
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  PADDLE
  LEMON_SQUEEZY
  WISE
}

enum PromptVisibility {
  PUBLIC
  PRIVATE
  TEAM
  UNLISTED
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ImportFormat {
  CSV
  JSON
  MARKDOWN
  GITHUB
}

enum SourceType {
  MANUAL
  GITHUB
  CSV
  JSON
  MARKDOWN
  API
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  username          String             @unique
  name              String?
  image             String?
  bio               String?
  password          String?
  role              UserRole           @default(USER)
  plan              SubscriptionPlan   @default(FREE)
  credits           Int                @default(100)
  dailyPromptCount  Int                @default(0)
  lastDailyReset    DateTime?
  emailVerified     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  prompts           Prompt[]
  favorites         Favorite[]
  collections       Collection[]
  templates         Template[]
  subscription      Subscription?
  usage             Usage[]
  activityLogs      ActivityLog[]
  reviews           Review[]
  orders            Order[]

  accounts          Account[]
  sessions          Session[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Prompt {
  id            String           @id @default(cuid())
  title         String
  content       String
  description   String?
  platform      String?
  categoryId    String?
  tone          String?
  language      String?
  complexity    String?
  length        String?
  outputFormat  String?
  variables     Json?
  tags          String[]
  visibility    PromptVisibility @default(PUBLIC)
  status        PromptStatus     @default(DRAFT)
  version       Int              @default(1)
  isTemplate    Boolean          @default(false)
  viewCount     Int              @default(0)
  copyCount     Int              @default(0)
  favoriteCount Int              @default(0)
  price         Decimal?         @default(0)
  currency      String?          @default("USD")
  isMarketplace Boolean          @default(false)
  source        SourceType       @default(MANUAL)
  sourceUrl     String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id])
  favorites  Favorite[]
  versions   PromptVersion[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@index([platform])
  @@index([createdAt])
  @@map("prompts")
}

model PromptVersion {
  id        String   @id @default(cuid())
  version   Int
  content   String
  title     String?
  changes   String?
  createdAt DateTime @default(now())

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@map("prompt_versions")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  prompts Prompt[]

  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?
  createdAt DateTime  @default(now())

  @@map("tags")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompts  Favorite[]

  @@unique([userId, name])
  @@map("collections")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId       String
  promptId     String
  collectionId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt     Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id])

  @@unique([userId, promptId])
  @@map("favorites")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  variables Json?
  platform  String?
  category  String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model Subscription {
  id              String             @id @default(cuid())
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(TRIALING)
  provider        PaymentProvider?
  providerId      String?
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd Boolean          @default(false)
  canceledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id           String   @id @default(cuid())
  amount       Decimal
  currency     String   @default("USD")
  status       String
  provider     PaymentProvider
  providerId   String?
  description  String?
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Order {
  id          String   @id @default(cuid())
  total       Decimal
  currency    String   @default("USD")
  status      String
  provider    PaymentProvider
  providerId  String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  price     Decimal
  createdAt DateTime @default(now())

  orderId  String
  promptId String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  promptId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@map("reviews")
}

model Source {
  id          String     @id @default(cuid())
  name        String
  type        SourceType
  url         String?
  apiKey      String?
  isActive    Boolean    @default(true)
  lastSyncAt  DateTime?
  config      Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  imports ImportJob[]

  @@map("sources")
}

model ImportJob {
  id          String       @id @default(cuid())
  format      ImportFormat
  status      String       @default("PENDING")
  fileUrl     String?
  fileCount   Int?
  imported    Int          @default(0)
  failed      Int          @default(0)
  duplicates  Int          @default(0)
  errors      Json?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  @@map("import_jobs")
}

model Usage {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("usage")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  discountType String
  discountValue Decimal
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("coupons")
}

model PaymentGateway {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  PaymentProvider
  isActive  Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_gateways")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("settings")
}
