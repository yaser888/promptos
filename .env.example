# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/promptos"

# GitHub (optional) — used by the GitHub importer to raise the API limit
# from 60/hr to 5000/hr. Without it, imports fall back to the tarball method.
GITHUB_TOKEN=

# Admin access key (demo mode only) — the secret that unlocks the admin login.
# Entry URL: /api/auth/demo?role=admin&key=YOUR_KEY
# Never commit this value; keep it known only to you.
ADMIN_ACCESS_KEY=

# Public variant of the key — compiled into the browser bundle and used by the
# hidden keyboard shortcut (type "admin" anywhere → instant admin redirect).
# It is discoverable in the JS bundle; set a different value if you want the
# two entry methods to have different secrets.
NEXT_PUBLIC_ADMIN_ACCESS_KEY=

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PromptOS"
