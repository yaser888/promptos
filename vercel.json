{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx prisma db push --skip-generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/blog-publisher",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/extensions",
      "schedule": "0 3 * * *"
    }
  ]
}
