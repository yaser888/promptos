{
  "name": "promptos",
  "version": "1.0.0",
  "private": true,
  "description": "PromptOS - The Prompt Operating System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
